{
  "description": "Batch/diagnostic MBA portfolio: fast chain and direct catalogue tiers run before residual Egglog. Fuzzy legacy permutations are disabled. Structural matching remains legacy-default; no production parity certificate is bundled. Egglog admits at most 500 ms per candidate and 5 s per live function; admission is structurally capped but Rust run(1) calls are not hard-interruptible.",
  "additional_configuration": {
    "pipeline_v2_mode": "config-v2",
    "pipeline_v2": [
      {
        "pass_id": "mba-simplify",
        "options": {
          "generate_commutative_permutations": false,
          "transforms": [
            "xor-chain",
            "and-chain",
            "or-chain",
            "arithmetic-chain",
            "add-hackers-delight-2",
            "add-hackers-delight-3",
            "add-hackers-delight-4",
            "and-hackers-delight-4",
            "or-hackers-delight-2",
            "or-mba-1",
            "sub-hackers-delight-2",
            "xor-hackers-delight-1",
            "xor-hackers-delight-3"
          ]
        }
      },
      {
        "pass_id": "mba-egraph",
        "options": {
          "families": ["add", "and", "bnot", "mul", "neg", "or", "sub", "xor"],
          "maturities": ["GLOBAL_ANALYZED"],
          "max_leaves": 4,
          "max_operator_nodes": 16,
          "max_degree": 2,
          "saturation_rounds": 4,
          "max_eclasses": 128,
          "max_enodes": 256,
          "max_rule_firings": 64,
          "cross_block_constant_preparation": true,
          "cross_block_def_use_preparation": true,
          "learned_replay_enabled": true,
          "learned_replay_max_entries": 256,
          "learned_replay_max_bytes": 2097152,
          "time_budget_ms": 500,
          "function_time_budget_ms": 5000,
          "residual_only": true,
          "require_proof": true
        }
      }
    ]
  },
  "ins_rules": [],
  "blk_rules": []
}
