ARG IDA_IMAGE=idapro-9.4
FROM ${IDA_IMAGE}
ARG D810_GUI_RUNTIME_LABEL=""

# Keep the disposable test runner offline after image construction.  Z3 stays
# outside IDA's virtualenv because d810 deliberately bootstraps its matching
# native library from this isolated directory.
RUN set -eux; \
    /app/ida/.venv/bin/pip install --no-cache-dir \
        typing-extensions \
        pyinstrument \
        "libcst>=1.0.0" \
        "pytest>=7.0.0" \
        "pytest-cov>=4.0.0" \
        "pytest-forked>=1.6.0" \
        "coverage[toml]>=7.0.0" \
        "import-linter>=2.0" \
        "vermin>=1.8.0" \
        "unicorn>=2.1,<3"; \
    /app/ida/.venv/bin/pip install --no-cache-dir \
        --target /root/.d810-speedups \
        "z3-solver>=4.13,<4.15.5"; \
    /app/ida/.venv/bin/python -c \
        "import builtins, sys; sys.path.insert(0, '/root/.d810-speedups'); builtins.Z3_LIB_DIRS = ['/root/.d810-speedups/z3/lib']; import pytest, unicorn, z3; assert (4, 13) <= z3.get_version() < (4, 15, 5); print('pytest', pytest.__version__, 'unicorn', unicorn.__version__, 'z3', z3.get_version_string())"; \
    rm -rf /root/.cache/pip /tmp/*

LABEL org.d810.test-runtime="dev-emulation-z3-v1"
LABEL org.d810.gui-runtime=${D810_GUI_RUNTIME_LABEL}
