{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://d810.local/sccp-cache-performance-receipt.schema.json",
  "title": "D810 SCCP and MOP cache performance receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "metadata",
    "runs",
    "cache_matrix",
    "sccp_summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "metadata": { "$ref": "#/$defs/metadata" },
    "runs": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/run" }
    },
    "cache_matrix": {
      "type": "array",
      "minItems": 9,
      "items": { "$ref": "#/$defs/cache_row" }
    },
    "sccp_summary": { "$ref": "#/$defs/sccp_summary" }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_negative_number": {
      "type": "number",
      "minimum": 0
    },
    "non_negative_integer": {
      "type": "integer",
      "minimum": 0
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "cache_stat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seq",
        "size",
        "weight",
        "hits",
        "misses",
        "max_size_ever",
        "max_weight_ever",
        "lookups",
        "insertions",
        "replacements",
        "capacity_evictions",
        "expirations",
        "explicit_removals",
        "weak_reference_removals",
        "configured_max_size",
        "configured_max_weight",
        "memory_delta_bytes",
        "real_api_calls"
      ],
      "properties": {
        "seq": { "$ref": "#/$defs/non_negative_integer" },
        "size": { "$ref": "#/$defs/non_negative_integer" },
        "weight": { "$ref": "#/$defs/non_negative_number" },
        "hits": { "$ref": "#/$defs/non_negative_integer" },
        "misses": { "$ref": "#/$defs/non_negative_integer" },
        "max_size_ever": { "$ref": "#/$defs/non_negative_integer" },
        "max_weight_ever": { "$ref": "#/$defs/non_negative_number" },
        "lookups": { "$ref": "#/$defs/non_negative_integer" },
        "insertions": { "$ref": "#/$defs/non_negative_integer" },
        "replacements": { "$ref": "#/$defs/non_negative_integer" },
        "capacity_evictions": { "$ref": "#/$defs/non_negative_integer" },
        "expirations": { "$ref": "#/$defs/non_negative_integer" },
        "explicit_removals": { "$ref": "#/$defs/non_negative_integer" },
        "weak_reference_removals": { "$ref": "#/$defs/non_negative_integer" },
        "configured_max_size": { "type": ["integer", "null"], "minimum": 1 },
        "configured_max_weight": { "type": ["number", "null"], "minimum": 0 },
        "memory_delta_bytes": { "type": "integer" },
        "real_api_calls": { "$ref": "#/$defs/non_negative_integer" }
      }
    },
    "cache_stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["MOP_CONSTANT_CACHE", "MOP_TO_AST_CACHE", "total_evictions", "memory_delta_bytes", "real_api_calls"],
      "properties": {
        "MOP_CONSTANT_CACHE": { "$ref": "#/$defs/cache_stat" },
        "MOP_TO_AST_CACHE": { "$ref": "#/$defs/cache_stat" },
        "total_evictions": { "$ref": "#/$defs/non_negative_integer" },
        "memory_delta_bytes": { "type": "integer" },
        "real_api_calls": { "$ref": "#/$defs/non_negative_integer" }
      }
    },
    "parity_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "constants", "executable_edges", "reachable_blocks", "program_fingerprint", "cfg_events", "value_events", "peak_cfg_queue", "peak_value_queue"],
      "properties": {
        "status": { "$ref": "#/$defs/non_empty_string" },
        "constants": { "type": "array" },
        "executable_edges": { "type": "array" },
        "reachable_blocks": { "type": "array" },
        "program_fingerprint": { "$ref": "#/$defs/non_empty_string" },
        "cfg_events": { "$ref": "#/$defs/non_negative_integer" },
        "value_events": { "$ref": "#/$defs/non_negative_integer" },
        "peak_cfg_queue": { "$ref": "#/$defs/non_negative_integer" },
        "peak_value_queue": { "$ref": "#/$defs/non_negative_integer" }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "label",
        "function_ea",
        "maturity",
        "overlay",
        "backend",
        "status",
        "program_fingerprint",
        "wall_seconds",
        "adapter_seconds",
        "solver_seconds",
        "cfg_events",
        "value_events",
        "constants_exposed",
        "edges_exposed",
        "fcp_patches",
        "cache_stats",
        "pseudocode_sha256",
        "cfg_sha256",
        "parity_projection",
        "parity_sha256",
        "real_api_calls"
      ],
      "properties": {
        "kind": { "enum": ["solver_replay", "full_decomp", "cache_replay"] },
        "label": { "$ref": "#/$defs/non_empty_string" },
        "function_ea": { "$ref": "#/$defs/non_negative_integer" },
        "maturity": { "$ref": "#/$defs/non_empty_string" },
        "overlay": { "enum": ["off", "on", "auto", "replay"] },
        "backend": { "enum": ["python", "cython", "python-fallback"] },
        "status": { "enum": ["converged", "work_limit", "block_limit", "error"] },
        "program_fingerprint": { "$ref": "#/$defs/non_empty_string" },
        "wall_seconds": { "$ref": "#/$defs/non_negative_number" },
        "adapter_seconds": { "$ref": "#/$defs/non_negative_number" },
        "solver_seconds": { "$ref": "#/$defs/non_negative_number" },
        "cfg_events": { "$ref": "#/$defs/non_negative_integer" },
        "value_events": { "$ref": "#/$defs/non_negative_integer" },
        "constants_exposed": { "$ref": "#/$defs/non_negative_integer" },
        "edges_exposed": { "$ref": "#/$defs/non_negative_integer" },
        "fcp_patches": { "$ref": "#/$defs/non_negative_integer" },
        "cache_stats": { "$ref": "#/$defs/cache_stats" },
        "pseudocode_sha256": { "$ref": "#/$defs/sha256" },
        "cfg_sha256": { "$ref": "#/$defs/sha256" },
        "parity_projection": { "$ref": "#/$defs/parity_projection" },
        "parity_sha256": { "$ref": "#/$defs/sha256" },
        "median_seconds": { "$ref": "#/$defs/non_negative_number" },
        "p95_seconds": { "$ref": "#/$defs/non_negative_number" },
        "warmup": { "$ref": "#/$defs/non_negative_integer" },
        "iterations": { "$ref": "#/$defs/non_negative_integer" },
        "constant_capacity": { "type": ["integer", "null"], "minimum": 1 },
        "ast_capacity": { "type": ["integer", "null"], "minimum": 1 },
        "real_api_calls": { "$ref": "#/$defs/non_negative_integer" }
      }
    },
    "cache_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "label",
        "function_ea",
        "maturity",
        "overlay",
        "backend",
        "status",
        "program_fingerprint",
        "wall_seconds",
        "adapter_seconds",
        "solver_seconds",
        "cfg_events",
        "value_events",
        "constants_exposed",
        "edges_exposed",
        "fcp_patches",
        "cache_stats",
        "pseudocode_sha256",
        "cfg_sha256",
        "constant_capacity",
        "ast_capacity",
        "workload_operations",
        "rebuilds",
        "evictions",
        "peak_weight",
        "memory_delta_bytes",
        "real_api_calls"
      ],
      "properties": {
        "kind": { "const": "cache_replay" },
        "label": { "$ref": "#/$defs/non_empty_string" },
        "function_ea": { "$ref": "#/$defs/non_negative_integer" },
        "maturity": { "$ref": "#/$defs/non_empty_string" },
        "overlay": { "const": "replay" },
        "backend": { "enum": ["python", "cython"] },
        "status": { "enum": ["converged", "work_limit", "block_limit", "error"] },
        "program_fingerprint": { "$ref": "#/$defs/non_empty_string" },
        "wall_seconds": { "$ref": "#/$defs/non_negative_number" },
        "adapter_seconds": { "$ref": "#/$defs/non_negative_number" },
        "solver_seconds": { "$ref": "#/$defs/non_negative_number" },
        "cfg_events": { "$ref": "#/$defs/non_negative_integer" },
        "value_events": { "$ref": "#/$defs/non_negative_integer" },
        "constants_exposed": { "$ref": "#/$defs/non_negative_integer" },
        "edges_exposed": { "$ref": "#/$defs/non_negative_integer" },
        "fcp_patches": { "$ref": "#/$defs/non_negative_integer" },
        "cache_stats": { "$ref": "#/$defs/cache_stats" },
        "pseudocode_sha256": { "$ref": "#/$defs/sha256" },
        "cfg_sha256": { "$ref": "#/$defs/sha256" },
        "constant_capacity": { "type": "integer", "minimum": 1 },
        "ast_capacity": { "type": "integer", "minimum": 1 },
        "workload_operations": { "$ref": "#/$defs/non_negative_integer" },
        "rebuilds": { "$ref": "#/$defs/non_negative_integer" },
        "evictions": { "$ref": "#/$defs/non_negative_integer" },
        "peak_weight": { "$ref": "#/$defs/non_negative_number" },
        "memory_delta_bytes": { "type": "integer" },
        "real_api_calls": { "$ref": "#/$defs/non_negative_integer" }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binary",
        "binary_sha256",
        "function_ea",
        "function_name",
        "maturity",
        "platform",
        "python",
        "ida_version",
        "fixture_source",
        "fixture_copy",
        "fixture_sha256",
        "capture_method",
        "workload_operations",
        "real_api_calls",
        "warmup",
        "iterations"
      ],
      "properties": {
        "binary": { "$ref": "#/$defs/non_empty_string" },
        "binary_sha256": { "$ref": "#/$defs/sha256" },
        "function_ea": { "$ref": "#/$defs/non_negative_integer" },
        "function_name": { "$ref": "#/$defs/non_empty_string" },
        "maturity": { "$ref": "#/$defs/non_empty_string" },
        "platform": { "$ref": "#/$defs/non_empty_string" },
        "python": { "$ref": "#/$defs/non_empty_string" },
        "ida_version": { "$ref": "#/$defs/non_empty_string" },
        "fixture_source": { "$ref": "#/$defs/non_empty_string" },
        "fixture_copy": { "$ref": "#/$defs/non_empty_string" },
        "fixture_sha256": { "$ref": "#/$defs/sha256" },
        "capture_method": { "$ref": "#/$defs/non_empty_string" },
        "workload_operations": { "$ref": "#/$defs/non_negative_integer" },
        "real_api_calls": { "$ref": "#/$defs/non_negative_integer" },
        "warmup": { "const": 3 },
        "iterations": { "const": 10 }
      }
    },
    "sccp_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests",
        "executions",
        "reuses",
        "fallbacks",
        "converged",
        "work_limit",
        "block_limit",
        "errors",
        "python_runs",
        "cython_runs",
        "cfg_events",
        "value_events",
        "adapter_seconds",
        "solver_seconds",
        "constants_exposed",
        "edges_exposed"
      ],
      "properties": {
        "requests": { "$ref": "#/$defs/non_negative_integer" },
        "executions": { "$ref": "#/$defs/non_negative_integer" },
        "reuses": { "$ref": "#/$defs/non_negative_integer" },
        "fallbacks": { "$ref": "#/$defs/non_negative_integer" },
        "converged": { "$ref": "#/$defs/non_negative_integer" },
        "work_limit": { "$ref": "#/$defs/non_negative_integer" },
        "block_limit": { "$ref": "#/$defs/non_negative_integer" },
        "errors": { "$ref": "#/$defs/non_negative_integer" },
        "python_runs": { "$ref": "#/$defs/non_negative_integer" },
        "cython_runs": { "$ref": "#/$defs/non_negative_integer" },
        "cfg_events": { "$ref": "#/$defs/non_negative_integer" },
        "value_events": { "$ref": "#/$defs/non_negative_integer" },
        "adapter_seconds": { "$ref": "#/$defs/non_negative_number" },
        "solver_seconds": { "$ref": "#/$defs/non_negative_number" },
        "constants_exposed": { "$ref": "#/$defs/non_negative_integer" },
        "edges_exposed": { "$ref": "#/$defs/non_negative_integer" }
      }
    }
  }
}
